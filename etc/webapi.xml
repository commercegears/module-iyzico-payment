<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/commercegears-iyzico/mine/orders/:orderId/payment-url" method="GET">
        <service class="CommerceGears\IyzicoPayment\Api\PaymentUrlManagementInterface" method="getForCustomer"/>
        <resources>
            <resource ref="self"/>
        </resources>
        <data>
            <parameter name="customerId" force="true">%customer_id%</parameter>
        </data>
    </route>
    <route url="/V1/commercegears-iyzico/guest-carts/:cartId/orders/:orderId/payment-url" method="GET">
        <service class="CommerceGears\IyzicoPayment\Api\PaymentUrlManagementInterface" method="getForGuest"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
