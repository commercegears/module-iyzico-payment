<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="CommerceGearsIyzicoTransactionsCsv" type="Magento\Ui\Model\Export\ConvertToCsv">
        <arguments>
            <argument name="metadataProvider" xsi:type="object">CommerceGears\IyzicoPayment\Model\Export\SafeMetadataProvider</argument>
        </arguments>
    </virtualType>
    <type name="CommerceGears\IyzicoPayment\Controller\Adminhtml\Transaction\ExportCsv">
        <arguments>
            <argument name="converter" xsi:type="object">CommerceGearsIyzicoTransactionsCsv</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="commercegears_iyzico_identity_not_mapped" xsi:type="string">CommerceGears\IyzicoPayment\Model\System\IdentityNotMappedMessage</item>
            </argument>
        </arguments>
    </type>
</config>
