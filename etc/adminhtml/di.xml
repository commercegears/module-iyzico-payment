<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="SoftawareIyzicoTransactionsCsv" type="Magento\Ui\Model\Export\ConvertToCsv">
        <arguments>
            <argument name="metadataProvider" xsi:type="object">Softaware\IyzicoPayment\Model\Export\SafeMetadataProvider</argument>
        </arguments>
    </virtualType>
    <type name="Softaware\IyzicoPayment\Controller\Adminhtml\Transaction\ExportCsv">
        <arguments>
            <argument name="converter" xsi:type="object">SoftawareIyzicoTransactionsCsv</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="softaware_iyzico_identity_not_mapped" xsi:type="string">Softaware\IyzicoPayment\Model\System\IdentityNotMappedMessage</item>
            </argument>
        </arguments>
    </type>
</config>
