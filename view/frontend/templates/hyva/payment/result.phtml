<?php
/**
 * @category  Softaware
 * @package   Softaware_IyzicoPayment
 * @copyright Copyright © Softaware Commerce Ltd (https://softawarecommerce.com/)
 *
 * Result page (Hyvä) for visitors who are not in the checkout session that placed the order.
 */
/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Softaware\IyzicoPayment\ViewModel\PaymentPage $viewModel */
$viewModel = $block->getData('view_model');
$state = $viewModel->getState();
$order = $viewModel->getIncrementId();
?>
<div class="max-w-2xl my-8 space-y-4">
    <?php if ($state === 'paid'): ?>
        <div class="message success"><span><?= $escaper->escapeHtml(__('Thank you. Your payment for order #%1 has been received.', $order)) ?></span></div>
        <p><?= $escaper->escapeHtml(__('You will receive an order confirmation by e-mail.')) ?></p>
    <?php elseif ($state === 'review'): ?>
        <div class="message notice"><span><?= $escaper->escapeHtml(__('Thank you. Your payment for order #%1 has been received and is being checked by iyzico.', $order)) ?></span></div>
        <p><?= $escaper->escapeHtml(__('This usually takes a short while. We will e-mail you as soon as your order is confirmed.')) ?></p>
    <?php elseif ($state === 'pending'): ?>
        <div class="message notice"><span><?= $escaper->escapeHtml(__('We are waiting for iyzico to confirm the payment for order #%1.', $order)) ?></span></div>
        <p><?= $escaper->escapeHtml(__('Please do not pay again. If you chose bank transfer, the order is confirmed when the transfer arrives.')) ?></p>
        <a class="btn btn-primary inline-flex" href="<?= $escaper->escapeUrl($viewModel->getCheckUrl()) ?>"><?= $escaper->escapeHtml(__('Check Again')) ?></a>
    <?php else: ?>
        <div class="message error"><span><?= $escaper->escapeHtml($viewModel->getMessage()) ?></span></div>
    <?php endif; ?>
    <p>
        <a class="underline" href="<?= $escaper->escapeUrl($state === 'failed' ? $viewModel->getCartUrl() : $viewModel->getHomeUrl()) ?>">
            <?= $escaper->escapeHtml($state === 'failed' ? __('Go to the Basket') : __('Continue Shopping')) ?>
        </a>
    </p>
</div>
